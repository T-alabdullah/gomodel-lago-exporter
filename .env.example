# Copy to .env and fill in. Every setting is EXPORTER_<NAME>; see exporter/config.py.

# GoModel's Postgres, read-only role (created in Step 5)
EXPORTER_GOMODEL_DB_URL=postgresql://exporter_ro:exporter_ro@localhost:5433/gomodel

# The exporter's own state database (created in Step 4)
EXPORTER_STATE_DB_URL=postgresql://postgres:exporter@localhost:5434/exporter

# Lago (API key from Developer -> API keys, Step 3)
EXPORTER_LAGO_API_URL=http://localhost:3000
EXPORTER_LAGO_API_KEY=

# Providers whose usage is billed (comma separated)
EXPORTER_BILLABLE_PROVIDERS=ollama-qai

# Combined service: exporter serve
EXPORTER_STATUS_HOST=127.0.0.1
EXPORTER_STATUS_PORT=8000
EXPORTER_RECONCILIATION_DELAY_SECONDS=900
EXPORTER_RECONCILIATION_RETRY_SECONDS=300
EXPORTER_RECONCILIATION_LOOKBACK_DAYS=7
EXPORTER_HEARTBEAT_STALE_SECONDS=300
EXPORTER_MONITOR_MAX_ROWS=10000
